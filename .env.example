# Copie ce fichier en ".env" et remplis tes propres valeurs.
# Ne commit JAMAIS le fichier ".env" réel sur GitHub.

# Obligatoire pour le résumé IA (sans elle, fallback en texte brut tronqué)
# Récupère ta clé gratuitement sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel : nom du modèle Gemini à utiliser.
# Vérifie le modèle actuellement en tier gratuit sur
# https://ai.google.dev/gemini-api/docs/pricing avant de lancer.
GEMINI_MODEL=gemini-2.5-flash

# Optionnel : pour activer la collecte Reddit
# Crée une app sur https://www.reddit.com/prefs/apps (type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gta6-watcher/0.1 by ton_pseudo_reddit
