      --border: #2a2a30;
      --text: #e8e8ea;
      --text-dim: #9a9aa2;
      --accent: #ff6b35;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    header {
      padding: 3rem 1.5rem 2rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    header h1 {
      font-size: 2.2rem;
      margin: 0 0 0.5rem;
      letter-spacing: -0.02em;
    }
    header h1 span { color: var(--accent); }
    header p {
      color: var(--text-dim);
      max-width: 560px;
      margin: 0 auto;
      font-size: 0.95rem;
    }
    main {
      max-width: 780px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    .meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      color: var(--text-dim);
      font-size: 0.85rem;
    }
    article.card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.4rem 1.6rem;
      margin-bottom: 1.1rem;
      transition: border-color 0.15s ease;
    }
    article.card:hover {
      border-color: #3a3a42;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }
    .source-tag {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--accent);
      font-weight: 600;
      white-space: nowrap;
    }
    .date-tag {
      font-size: 0.78rem;
      color: var(--text-dim);
      white-space: nowrap;
    }
    h2 {
      font-size: 1.1rem;
      margin: 0 0 0.6rem;
      line-height: 1.4;
    }
    h2 a {
      color: var(--text);
      text-decoration: none;
    }
    h2 a:hover { color: var(--accent); }
    .summary {
      color: #c8c8cd;
      font-size: 0.92rem;
      margin: 0 0 0.7rem;
    }
    .read-more {
      font-size: 0.85rem;
      color: var(--accent);
      text-decoration: none;
    }
    .read-more:hover { text-decoration: underline; }
    .empty-state {
      text-align: center;
      color: var(--text-dim);
      padding: 3rem 1rem;
    }
    footer {
      text-align: center;
      padding: 2rem;
      color: var(--text-dim);
      font-size: 0.8rem;
      border-top: 1px solid var(--border);
    }
    footer a { color: var(--text-dim); }
  </style>
</head>
<body>
  <header>
