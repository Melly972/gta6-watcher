---
// Cette page s'exécute au moment du BUILD (pas côté client) : elle lit
// directement les fichiers JSON générés par watcher.py dans ../output/
// et génère une page HTML statique avec leur contenu.

import fs from "node:fs";
import path from "node:path";

const outputDir = path.join(process.cwd(), "..", "output");

let articles = [];

if (fs.existsSync(outputDir)) {
  const files = fs
    .readdirSync(outputDir)
    .filter((f) => f.endsWith(".json"));

  for (const file of files) {
    const filePath = path.join(outputDir, file);
    try {
      const content = JSON.parse(fs.readFileSync(filePath, "utf-8"));
      articles.push(...content);
    } catch (e) {
      console.error(`Erreur de lecture ${file}:`, e);
    }
  }
}

// Dédup par URL (au cas où un article apparaîtrait dans plusieurs fichiers)
const seen = new Set();
articles = articles.filter((a) => {
  if (seen.has(a.url)) return false;
  seen.add(a.url);
  return true;
});

// Tri du plus récent au plus ancien
articles.sort((a, b) => new Date(b.date) - new Date(a.date));

// Limite d'affichage (évite une page trop longue si l'historique grossit)
const displayedArticles = articles.slice(0, 60);

function formatDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GTA 6 News — Actualités et résumés quotidiens</title>
  <meta name="description" content="Toute l'actualité de Grand Theft Auto 6 résumée automatiquement : leaks, annonces officielles, dates de sortie et plus." />
  <style>
    :root {
      --bg: #0d0d0f;
      --card-bg: #17171b;
      --border: #2a2a30;
      --text: #e8e8ea;
      --text-dim: #9a9aa2;
      --accent: #ff6b35;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    header {
      padding: 3rem 1.5rem 2rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    header h1 {
      font-size: 2.2rem;
      margin: 0 0 0.5rem;
      letter-spacing: -0.02em;
    }
    header h1 span { color: var(--accent); }
    header p {
      color: var(--text-dim);
      max-width: 560px;
      margin: 0 auto;
      font-size: 0.95rem;
    }
    main {
      max-width: 780px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    .meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      color: var(--text-dim);
      font-size: 0.85rem;
    }
    article.card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.4rem 1.6rem;
      margin-bottom: 1.1rem;
      transition: border-color 0.15s ease;
    }
    article.card:hover {
      border-color: #3a3a42;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }
    .source-tag {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--accent);
      font-weight: 600;
      white-space: nowrap;
    }
    .date-tag {
      font-size: 0.78rem;
      color: var(--text-dim);
      white-space: nowrap;
    }
    h2 {
      font-size: 1.1rem;
      margin: 0 0 0.6rem;
      line-height: 1.4;
    }
    h2 a {
      color: var(--text);
      text-decoration: none;
    }
    h2 a:hover { color: var(--accent); }
    .summary {
      color: #c8c8cd;
      font-size: 0.92rem;
      margin: 0 0 0.7rem;
    }
    .read-more {
      font-size: 0.85rem;
      color: var(--accent);
      text-decoration: none;
    }
    .read-more:hover { text-decoration: underline; }
    .empty-state {
      text-align: center;
      color: var(--text-dim);
      padding: 3rem 1rem;
    }
    footer {
      text-align: center;
      padding: 2rem;
      color: var(--text-dim);
      font-size: 0.8rem;
      border-top: 1px solid var(--border);
    }
    footer a { color: var(--text-dim); }
  </style>
</head>
<body>
  <header>
    <h1>GTA 6 <span>News</span></h1>
    <p>Résumés automatiques de l'actualité Grand Theft Auto 6 — annonces officielles, leaks, dates de sortie. Sources citées et liées pour chaque article.</p>
  </header>

  <main>
    <div class="meta-bar">
      <span>{displayedArticles.length} article{displayedArticles.length > 1 ? "s" : ""}</span>
      <span>Mis à jour automatiquement toutes les heures</span>
    </div>

    {displayedArticles.length === 0 && (
      <div class="empty-state">
        <p>Aucun article pour le moment. Revenez bientôt !</p>
      </div>
    )}

    {displayedArticles.map((article) => (
      <article class="card">
        <div class="card-header">
          <span class="source-tag">{article.source}</span>
          <span class="date-tag">{formatDate(article.date)}</span>
        </div>
        <h2>
          <a href={article.url} target="_blank" rel="noopener noreferrer nofollow">
            {article.title}
          </a>
        </h2>
        <p class="summary">{article.summary}</p>
        <a class="read-more" href={article.url} target="_blank" rel="noopener noreferrer nofollow">
          Lire l'article original →
        </a>
      </article>
    ))}
  </main>

  <footer>
    <p>Site indépendant non affilié à Rockstar Games ou Take-Two Interactive.<br />
    Chaque résumé est généré automatiquement et reformulé à partir de sources publiques, systématiquement créditées et liées.</p>
  </footer>
</body>
</html>
